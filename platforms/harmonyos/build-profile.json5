{
  "app": {
    "products": [
      {
        "name": "default",
        "bundleName": "com.memorybox.harmony",
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "compileSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "arkTSVersion": "1.1",
        "bundleType": "app",
        "versionCode": 1400,
        "versionName": "0.14.0",
        "resource": { "directories": ["./AppScope/resources"] },
        "output": { "artifactName": "MemoryBox-HarmonyOS-0.14.0" }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        { "name": "default", "applyToProducts": ["default"] }
      ]
    }
  ]
}
